---
import { getCollection } from "astro:content";
import AppLayout from "../layouts/AppLayout.astro";
import { phases } from "../domain/curriculum/roadmap";

const days = (await getCollection("days")).sort(
  (a, b) => a.data.dayNumber - b.data.dayNumber,
);
---

<AppLayout title="커리큘럼" current="curriculum">
  <div class="page-shell">
    <p class="eyebrow">2026.10.01 — 2026.12.31</p>
    <h1>92일 커리큘럼</h1>
    <p class="muted page-intro">
      2026년 10월 1일부터 12월 31일까지 하루 한 개념을 학습합니다. 매주 일곱째
      날은 앞서 배운 내용을 회상하고 작은 코드로 다시 확인합니다.
    </p>
    <div class="phase-list">
      {
        phases.map((phase, index) => {
          const phaseDays = days.filter((day) => day.data.phaseId === phase.id);
          return (
            <section class="phase card">
              <div class="phase-index">
                {String(index + 1).padStart(2, "0")}
              </div>
              <div class="phase-info">
                <>
                  <span>{phase.range}</span>
                  <h2>{phase.title}</h2>
                  <p>{phase.focus}</p>
                </>
              </div>
              <div class="phase-samples">
                {phaseDays.length ? (
                  phaseDays.map((day) => (
                    <a href={`/learn/${day.data.id}`}>
                      <span>
                        Day {String(day.data.dayNumber).padStart(2, "0")}
                      </span>
                      <strong>{day.data.title}</strong>
                      <small>
                        {day.data.anchorLanguage.toUpperCase()} Anchor ·{" "}
                        {day.data.estimatedMinutes}분
                      </small>
                    </a>
                  ))
                ) : (
                  <p class="muted">해당 Phase에 등록된 수업이 없습니다.</p>
                )}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</AppLayout>

<style>
  .page-intro {
    max-width: 50rem;
    font-size: 1.05rem;
  }
  .phase-list {
    display: grid;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .phase {
    display: grid;
    grid-template-columns: 4rem minmax(13rem, 0.8fr) minmax(18rem, 1.25fr);
    gap: 1.2rem;
    align-items: start;
    padding: 1.2rem;
  }
  .phase-index {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 0.8rem;
    font:
      900 1rem ui-monospace,
      monospace;
  }
  .phase-info > span {
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
  }
  .phase-info h2 {
    margin-top: 0.2rem;
    font-size: 1.25rem;
  }
  .phase-info p {
    color: var(--color-text-muted);
  }
  .phase-samples {
    display: grid;
    gap: 0.5rem;
  }
  .phase-samples a {
    display: grid;
    padding: 0.7rem 0.85rem;
    text-decoration: none;
    background: color-mix(in srgb, var(--color-bg) 60%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
  }
  .phase-samples a:hover {
    border-color: var(--color-accent);
  }
  .phase-samples span,
  .phase-samples small {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }
  .phase-samples strong {
    margin: 0.12rem 0;
  }
  .phase-samples p {
    margin: 0;
  }
  @media (max-width: 760px) {
    .phase {
      grid-template-columns: 3.3rem 1fr;
    }
    .phase-samples {
      grid-column: 1/-1;
    }
    .phase-index {
      width: 2.7rem;
      height: 2.7rem;
    }
  }
</style>
