---
import { getCollection } from "astro:content";
import AppLayout from "../layouts/AppLayout.astro";
import ProgressDashboard from "../components/progress/ProgressDashboard";
const days = (await getCollection("days"))
  .sort((a, b) => a.data.dayNumber - b.data.dayNumber)
  .map((day) => ({
    id: day.data.id,
    dayNumber: day.data.dayNumber,
    title: day.data.title,
    anchorLanguage: day.data.anchorLanguage,
    estimatedMinutes: day.data.estimatedMinutes,
  }));
---

<AppLayout title="진도" current="progress"
  ><div class="page-shell">
    <p class="eyebrow">Local-first progress</p><h1>학습 진도</h1><p
      class="muted page-copy"
    >
      진도와 실습 초안은 이 브라우저의 IndexedDB에 저장됩니다. 기기를 바꿀 때는
      설정에서 JSON 백업을 사용하세요.
    </p><div class="content-gap">
      <ProgressDashboard days={days} client:load />
    </div>
  </div></AppLayout
>
<style>
  .page-copy {
    max-width: 48rem;
  }
  .content-gap {
    margin-top: 2rem;
  }
</style>
